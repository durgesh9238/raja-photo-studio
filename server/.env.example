# Copy this file to ".env" and fill in your own values.

PORT=5000

# Where the website runs. Comma separated if you have more than one.
CLIENT_URL=http://localhost:5173

# MongoDB. Local:  mongodb://127.0.0.1:27017/raja-photo-studio
# Atlas (free cloud): paste the connection string from MongoDB Atlas here.
MONGO_URI=mongodb://127.0.0.1:27017/raja-photo-studio

# Email alerts (optional). Use a Gmail address with an "App Password"
# (Google Account > Security > 2-Step Verification > App passwords).
EMAIL_USER=
EMAIL_PASS=
# Where alerts should go. If empty, they go to EMAIL_USER.
NOTIFY_EMAIL=rajarajak@gmail.com
